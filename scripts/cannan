#!/bin/sh
# Find a supported interpreter without changing the system Python.
if ! command -v curl >/dev/null 2>&1; then
    echo '需要 curl。请先安装 curl，再运行此命令。' >&2
    exit 2
fi

supported_python() {
    "$1" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1
}

if [ -n "${CANNAN_PYTHON:-}" ]; then
    cannan_python=$(command -v "$CANNAN_PYTHON" 2>/dev/null) || {
        echo 'CANNAN_PYTHON 指定的解释器不可用。需要 Python 3.10+。' >&2
        exit 2
    }
    supported_python "$cannan_python" || {
        echo 'CANNAN_PYTHON 必须指向可运行的 Python 3.10+。' >&2
        exit 2
    }
else
    cannan_python=''
    for candidate in /opt/homebrew/bin/python3 /usr/local/bin/python3 python3 python3.14 python3.13 python3.12 python3.11 python3.10; do
        resolved=$(command -v "$candidate" 2>/dev/null) || continue
        if supported_python "$resolved"; then
            cannan_python=$resolved
            break
        fi
    done
    if [ -z "$cannan_python" ]; then
        echo '需要 Python 3.10+。macOS 可用 Homebrew 安装：brew install python；或设置 CANNAN_PYTHON 指向已有解释器。' >&2
        exit 2
    fi
fi

script_dir=${0%/*}
if [ "$script_dir" = "$0" ]; then script_dir=.; fi
script_dir=$(CDPATH= cd -- "$script_dir" && pwd) || exit 2
exec "$cannan_python" "$script_dir/bootstrap.py" "$@"
